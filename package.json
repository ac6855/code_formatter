{
  "name": "code-formatter",
  "version": "1.1.0",
  "description": "代码格式化器（前端 Monaco 编辑器 + 后端 Node 格式化引擎，Docker 部署）",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "^0.16.6",
    "@wasm-fmt/shfmt": "^0.2.7",
    "prettier": "^3.3.3",
    "sql-formatter": "^15.3.2",
    "terser": "^5.31.0",
    "xml-formatter": "^3.0.0"
  }
}
